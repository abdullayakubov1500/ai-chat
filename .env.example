# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Опционально
GEMINI_MODEL=gemini-2.0-flash
PORT=3001
WORKSHOP_PHONE=+7 (800) 555-12-34

# Фронтенд: true — моки без backend, false — запросы к /api/chat
VITE_USE_MOCK=false

# После изменения .env перезапустите: npm run dev

# Если API не на том же origin (обычно не нужно в dev)
# VITE_API_BASE_URL=
